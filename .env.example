# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0

# Vector DB & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
BM25_INDEX_DIR=./data/metadata/bm25_index.pkl
DOCUMENTS_DIR=./data/documents
FEEDBACK_DB_DIR=./data/feedback/feedback.db

# RAG & Graph Parameters
MAX_RETRIES=2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5

# API Configuration
HOST=0.0.0.0
PORT=8000
